            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@banco.com\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function(){",
                  "  var body = null;",
                  "  if (typeof pm !== 'undefined' && pm.response) {",
                  "    try { body = pm.response.json(); } catch(e) { body = null; }",
                  "  } else if (typeof res !== 'undefined' && typeof res.getBody === 'function') {",
                  "    try { body = JSON.parse(res.getBody()); } catch(e) { try { body = res.getBody(); } catch(e2) { body = null;} }",
                  "  }",
                  "  if (!body) return;",
                  "  if (!body.token) return;",
                  "  // Try Postman API first",
                  "  if (typeof pm !== 'undefined' && pm.collectionVariables && typeof pm.collectionVariables.set === 'function') {",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    pm.collectionVariables.set('userId', body.userId || '');",
                  "    pm.collectionVariables.set('role', body.role || '');",
                  "    pm.collectionVariables.set('fullName', body.fullName || '');",
                  "    return;",
                  "  }",
                  "  // Bruno / other clients: attempt common setters if available (best-effort, no-op otherwise)",
                  "  try {",
                  "    if (typeof client !== 'undefined' && typeof client.setEnvironmentVariable === 'function') {",
                  "      client.setEnvironmentVariable('token', body.token);",
                  "      client.setEnvironmentVariable('userId', body.userId || '');",
                  "      client.setEnvironmentVariable('role', body.role || '');",
                  "      client.setEnvironmentVariable('fullName', body.fullName || '');",
                  "      return;",
                  "    }",
                  "  } catch(e) { /* ignore */ }",
                  "  try {",
                  "    if (typeof setEnvironmentVariable === 'function') {",
                  "      setEnvironmentVariable('token', body.token);",
                  "      setEnvironmentVariable('userId', body.userId || '');",
                  "      setEnvironmentVariable('role', body.role || '');",
                  "      setEnvironmentVariable('fullName', body.fullName || '');",
                  "      return;",
                  "    }",
                  "  } catch(e) { /* ignore */ }",
                  "  // Fallback: log to console so Bruno/other clients can read it manually",
                  "  try { console.log('Auth response token:', body.token); } catch(e){}",
                  "})();"
                ]
              }
            }
          ]
        }
      ]
